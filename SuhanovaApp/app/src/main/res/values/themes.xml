<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme -->
    <style name="Theme.Suhanova" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_suhanova</item>
        <item name="windowSplashScreenIconBackgroundColor">#0A0A0F</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Suhanova.NoActionBar</item>
        <item name="android:statusBarColor">#0A0A0F</item>
        <item name="android:navigationBarColor">#0A0A0F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Post-splash theme — used by Compose, doesn't need AppCompat -->
    <style name="Theme.Suhanova.NoActionBar" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0A0F</item>
        <item name="android:navigationBarColor">#0A0A0F</item>
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>